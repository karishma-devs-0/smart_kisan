# Copy to .env and fill in your own values.
#
# Do NOT ask for, or share, the production .env. Two of these values are not
# just configuration:
#
#   DB_PASSWORD  full read/write/delete on the live database
#   JWT_SECRET   anyone holding this can mint a valid login token for ANY
#                user account, without a password
#
# For local testing you do not need either of the production values — use your
# own database and your own secret, as below. That gives you a working backend
# you can break freely without touching real data.

PORT=5000
NODE_ENV=development

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Easiest: create a free database at https://neon.tech (or run Postgres
# locally) and paste your own connection details here.
DB_HOST=your-db-host.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=true

# ─── JWT signing secret ──────────────────────────────────────────────────────
# Generate your own, do not reuse the production one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_your_own_32_byte_hex_string

# ─── Google Sign-In ──────────────────────────────────────────────────────────
# Public client id, safe to share.
GOOGLE_WEB_CLIENT_ID=782177553731-bhnqmugdoekfsg421kraclnjpab96n6q.apps.googleusercontent.com

# ─── AI irrigation scheduler tick (seconds) ──────────────────────────────────
AI_TICK_SECONDS=900

# ─── MQTT ────────────────────────────────────────────────────────────────────
# Public test broker; no credentials needed.
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── Email ──────────────────────────────────────────────────────────────────
# Used for sign-in codes, address verification and password reset.
#
# Two options. SMTP is used when set, otherwise Resend, otherwise the code is
# printed to the console (development only).
#
# OPTION A — Brevo (recommended for a deployed server). HTTPS, so it is not
# affected by the outbound SMTP blocking hosting platforms apply. No domain
# needed: verify a single sender address at brevo.com, free 300/day.
BREVO_API_KEY=

# OPTION B — Gmail SMTP. Works locally, but a hosted server usually cannot open
# an outbound SMTP connection: the attempt hangs rather than failing.
# Original note follows — Gmail SMTP. No domain required, sends to anyone, ~500/day.
#   1. Turn on 2-Step Verification on the Google account.
#   2. Create an App Password at myaccount.google.com/apppasswords
#      (a 16-character string; this is NOT the account password).
#   3. Fill in the three values below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=SmartKisan <your.address@gmail.com>

# OPTION B — Resend. Needs a domain you own, verified in their dashboard.
# Their shared onboarding@resend.dev sender only delivers to the address that
# owns the Resend account, so it cannot reach real users on its own.
RESEND_API_KEY=
