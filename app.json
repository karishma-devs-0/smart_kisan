{
  "expo": {
    "name": "SmartKisan",
    "slug": "SmartKisan",
    "scheme": "smartkisan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/smartKisanIcon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/smartKisanIcon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.smartkisan.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/smartKisanIcon_adaptive.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "queries": [
        {
          "intent": [
            {
              "action": "android.speech.RecognitionService"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/smartKisanIcon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4fa6ae46-9da2-4bb5-ac0d-a8cd9a7a09bd"
      }
    },
    "owner": "karishma_bhatia",
    "plugins": [
      "expo-localization",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "cameraPermission": "SmartKisan needs camera access to scan plant leaves for disease detection.",
          "photosPermission": "SmartKisan needs photo library access to upload plant leaf images."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "SmartKisan needs the microphone so you can speak instead of typing.",
          "speechRecognitionPermission": "SmartKisan needs speech recognition to understand what you say."
        }
      ]
    ]
  }
}
